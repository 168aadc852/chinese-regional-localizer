{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chinese Regional Localizer",
  "version": "0.1.0",
  "identifier": "org.chineseregionallocalizer.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Chinese Regional Localizer",
        "width": 1200,
        "height": 820,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "zoomHotkeysEnabled": true
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "presentation-zoom",
          "windows": ["main"],
          "permissions": ["core:webview:allow-set-webview-zoom"]
        }
      ]
    }
  },
  "bundle": {
    "active": false
  }
}
